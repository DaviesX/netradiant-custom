// Benchmark materials for the PBR gamepack.
// Grammar: one material per brace block, one keyword per line, case-insensitive.
// Textures: basecolor and emissive are sRGB; normal, metallicroughness (G = roughness, B = metallic)
// and occlusion (R) are linear. Unknown keywords (e.g. q3map_*) are skipped.
// Material names start with textures/ so they appear in the texture browser.

// brick: every map type
textures/bench/brick
{
	basecolor textures/bench/brick_c
	normal textures/bench/brick_n
	metallicroughness textures/bench/brick_mr
	occlusion textures/bench/brick_ao
	roughnessfactor 1
	metallicfactor 1
	q3map_lightmapsamplesize 8
}

// rough dielectric ground
textures/bench/asphalt
{
	basecolor textures/bench/asphalt_c
	normal textures/bench/asphalt_n
	metallicfactor 0
	roughnessfactor 1
}

textures/bench/concrete
{
	basecolor textures/bench/concrete_c
	normal textures/bench/concrete_n
	metallicfactor 0
	roughnessfactor 0.9
}

textures/bench/plaster
{
	basecolor textures/bench/plaster_c
	metallicfactor 0
	roughnessfactor 0.8
}

// polished metal: tight highlight tinted by the base colour, no diffuse
textures/bench/metal
{
	basecolor textures/bench/metal_c
	normal textures/bench/metal_n
	metallicroughness textures/bench/metal_mr
	metallicfactor 1
	roughnessfactor 1
}

// emissive neon sign
textures/bench/neon
{
	basecolor textures/bench/neon_c
	emissive textures/bench/neon_e
	emissivefactor 1 0.35 0.25
	emissivestrength 8
	metallicfactor 0
	roughnessfactor 0.6
}

// chain-link fence: alpha mask, both sides
textures/bench/fence
{
	basecolor textures/bench/fence
	alphamode mask
	alphacutoff 0.5
	doublesided
	metallicfactor 0.6
	roughnessfactor 0.5
	surfaceparm nonsolid
}

// window glass: alpha blend
textures/bench/glass
{
	basecolor textures/bench/glass
	basecolorfactor 0.8 0.9 1 0.35
	alphamode blend
	qer_trans 0.5
	metallicfactor 0
	roughnessfactor 0.05
}

// double-sided opaque sheet (hanging tarp)
textures/bench/tarp
{
	basecolor textures/bench/tarp_c
	doublesided
	metallicfactor 0
	roughnessfactor 0.9
}

textures/bench/sky
{
	qer_editorimage textures/bench/sky
	surfaceparm sky
	surfaceparm nodraw
}

textures/bench/fog
{
	qer_editorimage textures/bench/fog
	qer_trans 0.35
	surfaceparm fog
	surfaceparm nonsolid
}

textures/bench/caulk
{
	qer_editorimage textures/bench/caulk
	qer_nocarve
	surfaceparm nodraw
}

textures/bench/clip
{
	qer_editorimage textures/bench/clip
	qer_trans 0.4
	surfaceparm playerclip
	surfaceparm nonsolid
}

textures/bench/trigger
{
	qer_editorimage textures/bench/trigger
	qer_trans 0.4
	surfaceparm nodraw
	surfaceparm nonsolid
}
