<?xml version="1.0"?>
<!--
 Entity definitions for the PBR gamepack.
 Light units: "intensity" is radiant flux for light and light_spot and irradiance for
 light_sun; distances are raw map units (no metre conversion). See README.md.
-->
<classes>

<group name="worldspawn" color="0 0 0">
Only used for the world brushes and the map-wide keys below.
-------- KEYS --------
<string key="message" name="Message">Text shown when the map loads.</string>
<real key="gridsize" name="Grid Size" value="64">Light grid spacing in map units used by q3map2 (default 64).</real>
<real key="_ambient" name="Ambient" value="0">Compile-time ambient light added by q3map2 -light (q3map2 units, not used by the PBR preview).</real>
<string key="_blocksize" name="Block Size">Override of the BSP block size (default 1024).</string>
</group>

<point name="info_player_start" color="1 0 0" box="-16 -16 -24 16 16 32">
Player spawn point. The benchmark map's documented camera position is this entity.
-------- KEYS --------
<angle key="angle" name="Yaw Angle">Facing direction in degrees.</angle>
<target key="target" name="Target">Optional target.</target>
</point>

<point name="info_null" color="0 0.5 0" box="-8 -8 -8 8 8 8">
Aiming point for light_spot targets.
-------- KEYS --------
<targetname key="targetname" name="Target Name">Name used by the "target" key of other entities.</targetname>
</point>

<group name="func_group" color="0 0.5 0.8">
Editor-only grouping of brushes; the compiler merges it into worldspawn.
</group>

<point name="light" color="1 1 0.5" box="-8 -8 -8 8 8 8">
Point light with physical units.
-------- KEYS --------
<color key="_color" name="Colour" value="1 1 1">Linear RGB colour (default 1 1 1).</color>
<real key="intensity" name="Intensity" value="50000">Radiant flux (default 50000).</real>
<real key="radius" name="Radius" value="256">Cutoff distance in map units (default 256); the light is culled beyond it.</real>
<targetname key="targetname" name="Target Name">Name for targeting.</targetname>
-------- NOTES --------
Radiant intensity is intensity / (4 pi); irradiance falls off with the inverse square of the distance in map units.
</point>

<point name="light_spot" color="1 0.7 0.3" box="-8 -8 -8 8 8 8">
Spot light with physical units. Points along "angles", or at the entity named by "target" when set.
-------- KEYS --------
<color key="_color" name="Colour" value="1 1 1">Linear RGB colour (default 1 1 1).</color>
<real key="intensity" name="Intensity" value="50000">Radiant flux (default 50000). Narrowing the cone concentrates the same flux.</real>
<real key="radius" name="Radius" value="256">Cutoff distance in map units (default 256).</real>
<real key="cone" name="Cone" value="45">Outer cone half-angle in degrees (default 45).</real>
<real key="cone_inner" name="Cone Inner" value="30">Inner cone half-angle in degrees (default 30); full intensity inside, smoothstep to zero at the outer angle.</real>
<angles key="angles" name="Pitch Yaw Roll" value="0 0 0">Direction the light travels (pitch positive looks down).</angles>
<target key="target" name="Target">Entity to point at; takes precedence over angles.</target>
<targetname key="targetname" name="Target Name">Name for targeting.</targetname>
<boolean key="_shadows" name="Shadows" value="1">Whether the light casts shadows (default 1). Set 0 to light through occluders.</boolean>
-------- NOTES --------
Radiant intensity is intensity / (2 pi (1 - cos(cone))); inverse-square falloff in map units, culled beyond radius.
</point>

<point name="light_sun" color="1 0.9 0.6" box="-16 -16 -16 16 16 16">
Directional sun light. At most one is honoured: with several, the first in map order is used and the editor warns.
-------- KEYS --------
<color key="_color" name="Colour" value="1 1 1">Linear RGB colour (default 1 1 1).</color>
<real key="intensity" name="Intensity" value="3">Irradiance on a surface facing the sun (default 3).</real>
<angles key="angles" name="Pitch Yaw Roll" value="60 30 0">Direction the light travels (pitch positive looks down).</angles>
<boolean key="_shadows" name="Shadows" value="1">Whether the sun casts shadows (default 1). Set 0 to light through occluders.</boolean>
-------- NOTES --------
No cutoff: every lit surface receives the sun. The entity position only marks the sun in the editor.
</point>

</classes>
