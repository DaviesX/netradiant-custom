<?xml version="1.0"?>
<!--
  PBR gamepack: Quake 3 map format with glTF-style metallic-roughness materials
  (materials/*.mtr, shaders="pbr") and physical light entities (entities="pbr").
  The engine path is the directory that contains "base/"; pointing it at this
  gamepack's own directory (gamepacks/pbr.game/) makes the benchmark map and its
  materials visible without copying anything.
-->
<game
  type="q3"
  name="PBR (metallic-roughness materials, physical lights)"
  enginepath_win32="C:/games/pbr/"
  enginepath_linux="/usr/local/games/pbr/"
  enginepath_macos="/Applications/pbr/"
  engine_win32="ioquake3.exe"
  engine_linux="ioquake3"
  engine_macos="ioquake3.app"
  prefix=".pbr"
  basegame="base"
  basegamename="PBR"
  unknowngamename="Custom PBR modification"
  shaderpath="materials"
  archivetypes="pk3"
  texturetypes="png tga jpg"
  modeltypes="md3 ase lwo obj 3ds picoterrain"
  maptypes="mapq3"
  shaders="pbr"
  entityclass="quake3"
  entityclasstype="xml"
  entities="pbr"
  brushtypes="quake3"
  patchtypes="quake3"
  default_scale="0.5"
  q3map2_type="quake3"
  no_patch="0"
  common_shaders_name="Bench"
  common_shaders_dir="bench/"
  no_bsp_monitor="0"
  shader_trigger = "textures/bench/trigger"
/>
