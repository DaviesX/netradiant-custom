<?xml version="1.0"?>
<!--
  Overlay of the downloaded Quake III Arena game file (games/NRCPack/games/Q3.game), installed by the pbr
  gamepack after the downloaded packs. The only change is entities="pbr": the pbr entity module is the quake3
  module plus the editor's physical light entities (light, light_spot, light_sun), whose definitions come from
  Q3.game/baseq3/_pbr_lights.ent. See the pack's README.md (setup/data/gamepacks/pbr/) and CLAUDE.md.
-->
<game
  type="q3"
  index="1"
  name="Quake III Arena / Quake III: Team Arena"
  enginepath_win32="C:/Program Files (x86)/Quake III Arena/"
  enginepath_linux="/usr/local/games/quake3/"
  enginepath_macos="/Applications/Quake3/"
  engine_win32="quake3.exe"
  engine_linux="quake3"
  engine_macos="Quake3.app"
  prefix=".q3a"
  basegame="baseq3"
  basegamename="Quake III Arena"
  knowngame="missionpack"
  knowngamename="Quake III: Team Arena"
  unknowngamename="Custom Quake III modification"
  shaderpath="scripts"
  archivetypes="pk3"
  texturetypes="tga jpg"
  modeltypes="*"
  soundtypes="wav"
  maptypes="mapq3"
  shaders="quake3"
  entityclass="quake3"
  entityclasstype="def xml"
  entities="pbr"
  brushtypes="quake3"
  patchtypes="quake3"
  default_scale="0.5"
  q3map2_type="quake3"
  no_patch="0"
  common_shaders_name="Common"
  common_shaders_dir="common/"
  no_bsp_monitor="0"
  shader_trigger = "textures/common/trigger"
/>
