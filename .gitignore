*.[oda]
/.settings/
/games/
/install/
/.vscode/
/.idea/
/.cache/
/.clang*
!/.clang-format
!/.clang-format-ignore
/compile_commands.json
# q3map2 compile outputs in the content mods
/content/*/maps/*.bsp
/content/*/maps/*.prt
/content/*/maps/*.srf
/content/*/maps/*.lin
/content/*/maps/*.bak
/content/*/maps/*.autosave.map
/content/*/maps/lm_*
/content/*/maps/*/lm_*
/content/*/maps/*/*.shsf
# stock check output
/stockcheck-out/
/tools/quake3/q3map2/q3map2_extension_test.*
!/tools/quake3/q3map2/q3map2_extension_test.cpp
/tools/quake3/q3map2/light_sh_model_test.*
!/tools/quake3/q3map2/light_sh_model_test.cpp
/libs/emissivelight_test.*
!/libs/emissivelight_test.cpp
/libs/skylight_test.*
!/libs/skylight_test.cpp
/libs/fogvolume_test.*
!/libs/fogvolume_test.cpp
/tools/quake3/q3map2/light_sh.stamp
# python bytecode of the stock check (imported by its tests)
/tools/stockcheck/__pycache__/
